# .env.example - Contoh Konfigurasi Environment Kaiwa Dojo
# Salin file ini menjadi .env.local untuk konfigurasi lokal Anda:
#   cp .env.example .env.local

# ── 1. Base URL API Backend ──
# Di produksi atau shared hosting, API berada di folder /api
VITE_API_BASE=/api

# ── 2. Kontak Admin WhatsApp ──
# Nomor WhatsApp Admin untuk verifikasi pendaftaran & tombol bantuan
VITE_ADMIN_WA_NUMBER=087875018001
